# Copy to .env for local development. On Vercel, set these as Environment Variables
# in the project settings instead (do NOT commit a real .env).

# --- Core ---
PROJECT_NAME="Ortopedia Clinic API"
# development | staging | production | test
ENVIRONMENT=development

# --- Database ---
# Local (docker-compose):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ortopedia
# Vercel/production: use a managed Postgres (Neon, Supabase, Vercel Postgres).
# Prefer the POOLED connection string (e.g. Neon's "-pooler" host).
# Example: postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require

# --- Auth ---
# MUST be overridden in production. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- CORS ---
# Comma-separated list of allowed frontend origins (no trailing slash).
# e.g. https://your-frontend.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Initial admin bootstrap ---
# For local dev you can let the app create the admin on startup.
# On Vercel, run `python -m scripts.seed_admin` once instead (lifespan doesn't run).
CREATE_INITIAL_ADMIN=false
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
